#!/usr/bin/env bash
# Minimal helper intended to be sourced: `source ./activate`
#
# Usage (preferred):
#   source ./activate
#
# If run as an executable, the script will instruct you to source it.

VENV_DIR=".venv"
ACTIVATE_SCRIPT="$VENV_DIR/bin/activate"

if [ ! -f "$ACTIVATE_SCRIPT" ]; then
  echo "Virtual environment not found at $VENV_DIR." >&2
  echo "Create it with: python -m venv .venv" >&2
  # If sourced, return a failure code; otherwise exit.
  if [ "${BASH_SOURCE[0]}" != "${0}" ]; then
    return 1 2>/dev/null || true
  else
    exit 1
  fi
fi

# If the file is executed (not sourced), print guidance and exit.
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  cat <<'EOF' >&2
This file is intended to be sourced into your current shell so the venv
activation persists. Run:

  source ./activate

Or create the venv first with:

  python -m venv .venv

EOF
  exit 0
fi

# Source the venv activation script into the current shell.
# shellcheck disable=SC1090
. "$ACTIVATE_SCRIPT"

